# Server
# PostgreSQL connection string. When absent, the app runs on an in-memory
# store (data resets on restart) — fine for a quick demo, not for anything else.
DATABASE_URL=postgres://user:password@host:5432/triage_life

# Secret used to sign session cookies and upload tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port (default 3000)
# PORT=3000

# --- Object storage for original documents -------------------------------
# "local" keeps files in STORAGE_DIR (default ./storage); "s3" uses any
# S3-compatible bucket via the standard AWS credential chain.
STORAGE_DRIVER=local
# STORAGE_DIR=storage
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_PREFIX=triage

# --- OCR -------------------------------------------------------------------
# auto (default): Textract when AWS credentials are present, else the demo
# provider. demo: synthetic documents only. textract: force Textract.
# OCR_PROVIDER=auto

# --- Agent -----------------------------------------------------------------
# deterministic (default): parses the synthetic demo documents, no external
# model. strands: Strands Agents SDK (@strands-agents/sdk) drives the same
# tools through a real agent loop with the model provider below.
# AGENT_PROVIDER=deterministic

# Strands model provider:
#   bedrock — AWS credential chain (default). MODEL_ID optional (defaults to
#             Claude Sonnet 4.6 on Bedrock).
#   openai  — any OpenAI-compatible endpoint (incl. local: Ollama/vLLM serve
#             /v1). Requires all three of OPENAI_BASE_URL, OPENAI_API_KEY,
#             MODEL_ID.
# STRANDS_MODEL_PROVIDER=bedrock
# MODEL_ID=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
