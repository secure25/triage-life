# Server
# PostgreSQL connection string — for Neon, use the POOLED string here (the
# host contains "-pooler"). When absent, the app runs on an in-memory store
# (data resets on restart) — fine for a quick demo, not for anything else.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct (unpooled) connection for schema migrations only (Neon: the string
# WITHOUT "-pooler" in the host). Optional — drizzle-kit falls back to
# DATABASE_URL if unset.
# DIRECT_DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies and upload tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port (default 3000)
# PORT=3000

# --- AWS (Textract OCR, S3 storage, Bedrock for the Strands engine) ------
# Credentials for one IAM user with least-privilege access (see README).
# AWS_REGION applies to every SDK client (Textract, Bedrock); keep it a
# region where your Bedrock model access is enabled (us-east-1 is safest).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Object storage for original documents -------------------------------
# "local" keeps files in STORAGE_DIR (default ./storage); "s3" uses any
# S3-compatible bucket via the standard AWS credential chain. S3 is required
# for Textract PDF OCR (async jobs read the PDF from S3).
STORAGE_DRIVER=local
# STORAGE_DIR=storage
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_PREFIX=triage

# --- OCR -------------------------------------------------------------------
# auto (default): Textract when AWS credentials are present, else the demo
# provider. demo: synthetic documents only. textract: force Textract.
# OCR_PROVIDER=auto

# --- Agent -----------------------------------------------------------------
# deterministic (default): parses the synthetic demo documents, no external
# model. strands: Strands Agents SDK (@strands-agents/sdk) drives the same
# tools through a real agent loop with the model provider below.
# AGENT_PROVIDER=deterministic

# Strands model provider:
#   bedrock        — AWS credential chain (default). MODEL_ID optional (defaults
#                    to Claude Sonnet 4.6 on Bedrock).
#   bedrock-mantle — Bedrock's Mantle endpoint
#                    (https://bedrock-mantle.<region>.api.aws). Claude models
#                    run via the Anthropic-native Messages API
#                    (/anthropic/v1/messages); short-term bearer tokens are
#                    minted automatically from the standard AWS credential
#                    chain via @aws/bedrock-token-generator. Requires MODEL_ID
#                    with a region-local Mantle id — no us./global. prefixes
#                    (cross-region profiles are not supported on Mantle), e.g.
#                    anthropic.claude-opus-4-8. Region defaults to
#                    AWS_REGION / AWS_DEFAULT_REGION; set BEDROCK_MANTLE_REGION
#                    to override.
#   openai         — any OpenAI-compatible endpoint (incl. local: Ollama/vLLM
#                    serve /v1). Requires all three of OPENAI_BASE_URL,
#                    OPENAI_API_KEY, MODEL_ID.
# STRANDS_MODEL_PROVIDER=bedrock
# MODEL_ID=
# BEDROCK_MANTLE_REGION=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
